  },
  "P-PASTAPOLLO": {
   "name": "Pasta al pomodoro con pollo",
   "how": "Pollo a pezzetti rosolato in padella con l'olio, poi la passata; si condisce la pasta e si mette il grana.",
   "kind": "pranzo"
  },
  "P-INTTONNO": {
   "name": "Pasta integrale fredda con tonno e pomodori",
   "how": "Pasta lessata e raffreddata, condita con tonno sgocciolato, pomodori a pezzi e olio. Senza sale aggiunto.",
   "kind": "pranzo"
  },
  "P-INTTACCHINO": {
   "name": "Pasta integrale con tacchino e peperoni",
   "how": "Tacchino a striscioline e peperoni in padella con l'olio; si condisce la pasta.",
   "kind": "pranzo"
  },
  "P-RISOPOLLO": {
   "name": "Riso con pollo e peperoni",
   "how": "Pollo a pezzetti e peperoni in padella con l'olio, poi si unisce il riso lessato.",
   "kind": "pranzo"
  },
  "P-WRAP": {
   "name": "Wrap di pollo, insalata e pomodori",
   "how": "Pollo alla piastra a striscioline; nei wrap con insalata e pomodori conditi con l'olio.",
   "kind": "pranzo"
  },
  "C-MERLUZZO": {
   "name": "Merluzzo al forno con patate e carote",
   "how": "Patate a spicchi in friggitrice ad aria o forno; merluzzo al forno; carote crude o cotte; olio a crudo.",
   "kind": "cena"
  },
  "C-BURGER": {
   "name": "Hamburger nel pane con insalata",
   "how": "Hamburger alla piastra senza olio; pane tagliato a metà; insalata condita con l'olio.",
   "kind": "cena"
  },
  "C-ORATA": {
   "name": "Orata al forno con patate e insalata",
   "how": "Filetti al forno o in friggitrice ad aria; patate a spicchi; olio a crudo.",
   "kind": "cena"
  },
  "C-SGOMBRO": {
   "name": "Insalata di patate, sgombro e pomodori",
   "how": "Patate lessate a cubetti, sgombro sgocciolato, pomodori, olio.",
   "kind": "cena"
  },
  "C-TONNOPATATE": {
   "name": "Patate, tonno e pomodori",
