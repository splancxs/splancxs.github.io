// swift-tools-version: 6.0
// Modello del pacchetto per xtool: installa.sh sostituisce @NPM@ con la cartella dei plugin ufficiali di Capacitor.
import PackageDescription

// Il linker di xtool (lld) scrive «sdk 17.0» nel file: iOS allora non applica il Liquid Glass.
// Con -platform_version dico l'SDK vero. Il resto serve alla firma e alle estensioni:
//   -headerpad  lascia spazio per la firma nel file
//   -u _main    obbliga a includere il codice dell'estensione, che altrimenti il linker scarta (esce un guscio vuoto)
let linker: [LinkerSetting] = [.unsafeFlags([
    "-Xlinker", "-platform_version", "-Xlinker", "ios", "-Xlinker", "18.0", "-Xlinker", "27.0",
    "-Xlinker", "-headerpad", "-Xlinker", "0x4000",
    "-Xlinker", "-u", "-Xlinker", "_main",
])]

let package = Package(
    name: "RecompProva",
    platforms: [.iOS(.v18)],
    products: [
        .library(name: "RecompProva", targets: ["RecompProva"]),
        .library(name: "RecompLive", targets: ["RecompLive"]),
    ],
    dependencies: [
        .package(url: "https://github.com/ionic-team/capacitor-swift-pm.git", exact: "8.5.2"),
        .package(path: "@NPM@/app"),
        .package(path: "@NPM@/browser"),
        .package(path: "@NPM@/haptics"),
        .package(path: "@NPM@/local-notifications"),
        .package(path: "@NPM@/status-bar"),
    ],
    targets: [
        .target(
            name: "RecompProva",
            dependencies: [
                .product(name: "Capacitor", package: "capacitor-swift-pm"),
                .product(name: "Cordova", package: "capacitor-swift-pm"),
                .product(name: "CapacitorApp", package: "app"),
                .product(name: "CapacitorBrowser", package: "browser"),
                .product(name: "CapacitorHaptics", package: "haptics"),
                .product(name: "CapacitorLocalNotifications", package: "local-notifications"),
                .product(name: "CapacitorStatusBar", package: "status-bar"),
            ],
            swiftSettings: [.swiftLanguageMode(.v5)],
            linkerSettings: linker
        ),
        .target(
            name: "RecompLive",
            swiftSettings: [.swiftLanguageMode(.v5)],
            linkerSettings: linker
        ),
    ]
)
